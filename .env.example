# Safe offline demo mode. Set to false for the real Odoo integration.
MOCK_ODOO=true
ODOO_URL=https://aspireapplication.odoo.com
# Usually optional for an Odoo Online subdomain. If required, use the database name.
ODOO_DB=
# Create this in Odoo under your account security/preferences. Do not use your login password here.
ODOO_API_KEY=
CACHE_TTL=60
ODOO_TIMEOUT=15
REPORTING_CURRENCY=LBP
USD_TO_LBP_RATE=89500
